           })\n435:                 remediations.append({\n436:                     \"phase\": \"REMEDIATION\",\n437:                     \"system_id\": sys_id,\n438:                     \"resource_id\": res_id,\n439:                     \"operation\": \"DISABLE_DATA_FLOW\",\n440:                     \"state\": \"DISABLED\",\n441:                     \"evidence_id\": \"\"\n442:                 })\n443:                 verifications.append({\n444:                     \"phase\": \"VERIFICATION\",\n445:                     \"system_id\": sys_id,\n446:                     \"resource_id\": res_id,\n447:                     \"operation\": \"VERIFY_DATA_FLOW_DISABLED\",\n448:                     \"state\": \"DISABLED\",\n449:                     \"evidence_id\": \"\"\n450:                 })\n451:             elif op_type == 'RESTORE_RISK':\n452:                 has_violations = True\n453:                 findings.append({\n454:                     \"phase\": \"FINDING\",\n455:                     \"system_id\": sys_id,\n456:                     \"resource_id\": res_id,\n457:                     \"operation\": \"REPORT_RESTORE_RISK\",\n458:                     \"state\": \"ACTIVE\",\n459:                     \"evidence_id\": ev_cite\n460:                 })\n461:                 remediations.append({\n462:                     \"phase\": \"REMEDIATION\",\n463:                     \"system_id\": sys_id,\n464:                     \"resource_id\": res_id,\n465:                     \"operation\": \"BLOCK_RESTORE\",\n466:                     \"state\": \"BLOCKED\",\n467:                     \"evidence_id\": \"\"\n468:                 })\n469:                 verifications.append({\n470:                     \"phase\": \"VERIFICATION\",\n471:                     \"system_id\": sys_id,\n472:                     \"resource_id\": res_id,\n473:                     \"operation\": \"VERIFY_RESTORE_BLOCKED\",\n474:                     \"state\": \"BLOCKED\",\n475:                     \"evidence_id\": \"\"\n476:                 })\n477:             elif op_type == 'SECURITY_AUDIT_LOG':\n478:                 verifications.append({\n479:                     \"phase\": \"VERIFICATION\",\n480:                     \"system_id\": sys_id,\n481:                     \"resource_id\": res_id,\n482:                     \"operation\": \"VERIFY_RECORD_PRESENT\",\n483:                     \"state\": \"PRESENT\",\n484:                     \"evidence_id\": ev_cite\n485:                 })\n486:             elif op_type == 'COMPLIANT_ANONYMIZED':\n487:                 verifications.append({\n488:                     \"phase\": \"VERIFICATION\",\n489:                     \"system_id\": sys_id,\n490:                     \"resource_id\": res_id,\n491:                     \"operation\": \"VERIFY_RECORD_ANONYMIZED\",\n492:                     \"state\": \"ANONYMIZED\",\n493:                     \"evidence_id\": ev_cite\n494:                 })\n495:             elif op_type == 'COMPLIANT_REDACTED':\n496:                 verifications.append({\n497:                     \"phase\": \"VERIFICATION\",\n498:                     \"system_id\": sys_id,\n499:                     \"resource_id\": res_id,\n500:                     \"operation\": \"VERIFY_RECORD_REDACTED\",\n501:                     \"state\": \"REDACTED\",\n502:                     \"evidence_id\": ev_cite\n503:                 })\n504:             elif op_type == 'COMPLIANT_DISABLED':\n505:                 verifications.append({\n506:                     \"phase\": \"VERIFICATION\",\n507:                     \"system_id\": sys_id,\n508:                     \"resource_id\": res_id,\n509:                     \"operation\": \"VERIFY_DATA_FLOW_DISABLED\",\n510:                     \"state\": \"DISABLED\",\n511:                     \"evidence_id\": ev_cite\n512:                 })\n513:             elif op_type == 'COMPLIANT_BLOCKED':\n514:                 verifications.append({\n515:                     \"phase\": \"VERIFICATION\",\n516:                     \"system_id\": sys_id,\n517:                     \"resource_id\": res_id,\n518:                     \"operation\": \"VERIFY_RESTORE_BLOCKED\",\n519:                     \"state\": \"BLOCKED\",\n520:                     \"evidence_id\": ev_cite\n521:                 })\n522: \n523:         # Deduplicate verifications\n524:         unique_verifications = []\n525:         seen_keys = set()\n526:         for v in verifications:\n527:             k = (v['system_id'], v['resource_id'], v['operation'])\n528:             if k not in seen_keys:\n529:                 seen_keys.add(k)\n530:                 unique_verifications.append(v)\n531:         verifications = unique_verifications\n532: \n533:         if has_violations:\n534:             status = \"INCOMPLETE\"\n535:             has_acc_ver = any(v['system_id'] == 'account_service' for v in verifications)\n536:             if not has_acc_ver and account_id:\n537:                 verifications.append({\n538:                     \"phase\": \"VERIFICATION\",\n539:                     \"system_id\": \"account_service\",\n540:                     \"resource_id\": account_id,\n541:                     \"operation\": \"VERIFY_RECORD_ABSENT\",\n542:                     \"state\": \"ABSENT\",\n543:                     \"evidence_id\": \"\"\n544:                 })\n545:             for v in verifications:\n546:                 v['evidence_id'] = \"\"\n547:             all_steps = findings + remediations + verifications\n548:         else:\n549:             status = \"COMPLETE\"\n550:             has_acc_ver = any(v['system_id'] == 'account_service' for v in verifications)\n551:             if not has_acc_ver and account_id:\n552:                 verifications.append({\n553:                     \"phase\": \"VERIFICATION\",\n554:                     \"system_id\": \"account_service\",\n555:                     \"resource_id\": account_id,\n556:                     \"operation\": \"VERIFY_RECORD_ABSENT\",\n557:                     \"state\": \"ABSENT\",\n558:                     \"evidence_id\": chosen_ev_id\n559:                 })\n560:             all_steps = verifications\n561: \n562:         sorted_steps = sort_steps(all_steps)\n563:         return status, json.dumps(sorted_steps, separators=(',', ':'))\n564: \n565:     def _parse_evidence_file_for_user(self, eid: str, fpath: str, origin: str, user_profile: Dict[str, Any]) -> List[Dict[str, Any]]:\n566:         uid = user_profile['user_id']\n567:         emails = user_profile['emails']\n568:         hashes = user_profile.get('hashes', set())\n569:         phones = user_profile.get('phones', set())\n570:         records: List[Dict[str, Any]] = []\n571: \n572:         try:\n573:             # Format 1: Text handover\n574:             if fpath.endswith('.txt'):\n575:                 with open(fpath, mode='r', encoding='utf-8') as fp:\n576:                     for line in fp:\n577:                         if not line.strip().startswith('-'):\n578:                             continue\n579:                         parts = [p.strip() for p in line.strip().lstrip('-').split('|')]\n580:                         if len(parts) >= 6:\n581:                             ts, sys_id, res_id, category, st, ident = parts[:6]\n582:                             if ident.lower() in emails or (uid and ident == uid) or ident.lower() in hashes:\n583:                                 if category == 'USER_PROFILE':\n584:                                     records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'ACCOUNT_PROFILE', 'state': 'ABSENT' if st == 'NOT_FOUND' else 'PRESENT', 'evidence_id': eid})\n585:                                 elif category == 'SEARCH_INDEX_ENTRY':\n586:                                     if st == 'FOUND':\n587:                                         records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'REMAINING_RECORD', 'state': 'PRESENT', 'evidence_id': eid})\n588:                                 elif category == 'ANALYTICS_PROFILE':\n589:                                     if st == 'IDENTIFIABLE':\n590:                                         records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'EXPOSED_PII', 'state': 'PRESENT', 'evidence_id': eid})\n591:                                     elif st == 'ANONYMIZED':\n592:                                         records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'COMPLIANT_ANONYMIZED', 'state': 'ANONYMIZED', 'evidence_id': eid})\n593:                                 elif category == 'DATA_FLOW':\n594:                                     if st == 'ACTIVE':\n595:                                         records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'ACTIVE_DATA_FLOW', 'state': 'ACTIVE', 'evidence_id': eid})\n596:                                     elif st == 'DISABLED':\n597:                                         records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'COMPLIANT_DISABLED', 'state': 'DISABLED', 'evidence_id': eid})\n598:                                 elif category == 'BACKUP_ARCHIVE':\n599:                                     if st == 'ACTIVE':\n600:                                         records.append({'system_id': sys_id, 'resource_id': res_id, 'type': 'RESTORE_RISK', 'state': 'ACTIVE', 'evidence_id': eid})"}
