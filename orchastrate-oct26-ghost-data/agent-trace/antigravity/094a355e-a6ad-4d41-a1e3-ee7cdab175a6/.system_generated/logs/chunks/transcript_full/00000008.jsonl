m in se.get('account_service', {}).get('profile_lookups', []):\n623:                         if item.get('lookup_key') in emails or item.get('resource_id') == user_profile.get('user_id'):\n624:                             records.append({'system_id': 'account_service', 'resource_id': item['resource_id'], 'type': 'ACCOUNT_PROFILE', 'state': 'ABSENT' if item.get('status_code') == 404 else 'PRESENT', 'evidence_id': eid})\n625:                     # search_service\n626:                     for item in se.get('search_service', {}).get('index_queries', []):\n627:                         if item.get('query') in emails:\n628:                             hits = item.get('hits', {})\n629:                             if hits.get('total', 0) > 0:\n630:                                 records.append({'system_id': 'search_service', 'resource_id': item['resource_id'], 'type': 'REMAINING_RECORD', 'state': 'PRESENT', 'evidence_id': eid})\n631:                             else:\n632:                                 records.append({'system_id': 'search_service', 'resource_id': item['resource_id'], 'type': 'COMPLIANT_ABSENT', 'state': 'ABSENT', 'evidence_id': eid})\n633:                     # analytics_platform\n634:                     for item in se.get('analytics_platform', {}).get('profiles', []):\n635:                         if item.get('email') in emails or (uid and item.get('customer_reference') == uid):\n636:                             if item.get('email') or item.get('phone'):\n637:                                 records.append({'system_id': 'analytics_platform', 'resource_id': item['resource_id'], 'type': 'EXPOSED_PII', 'state': 'PRESENT', 'evidence_id': eid})\n638:                             else:\n639:                                 records.append({'system_id': 'analytics_platform', 'resource_id': item['resource_id'], 'type': 'COMPLIANT_ANONYMIZED', 'state': 'ANONYMIZED', 'evidence_id': eid})\n640:                     # support_platform\n641:                     for it