{"step_index":506,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T18:22:38Z","content":"Created At: 2026-10-24T23:52:38+05:30\nCompleted At: 2026-10-24T23:52:38+05:30\nShowing lines 201-400 of 925\n201:     phase_order = {'FINDING': 1, 'REMEDIATION': 2, 'VERIFICATION': 3}\n202:     \n203:     def step_sort_key(s: Dict[str, Any]):\n204:         p_val = phase_order.get(s['phase'], 99)\n205:         op = s['operation']\n206:         if s['phase'] == 'FINDING':\n207:             op_val = FINDING_ORDER.index(op) if op in FINDING_ORDER else 99\n208:         elif s['phase'] == 'REMEDIATION':\n209:             op_val = REMEDIATION_ORDER.index(op) if op in REMEDIATION_ORDER else 99\n210:         else:\n211:             op_val = VERIFICATION_ORDER.index(op) if op in VERIFICATION_ORDER else 99\n212:             \n213:         sys_id = s.get('system_id', '')\n214:         res_id = s.get('resource_id', '')\n215:         return (p_val, op_val, sys_id, res_id)\n216: \n217:     sorted_list = sorted(steps, key=step_sort_key)\n218:     for idx, s in enumerate(sorted_list):\n219:         s['step_no'] = idx + 1\n220:     return sorted_list\n221: \n222: \n223: # ==============================================================================\n224: # 5. AUDIT PIPELINE ENGINE\n225: # ==============================================================================\n226: \n227: class DeletionAuditAgent:\n228:     def __init__(self, dataset_dir: str):\n229:         self.dataset_dir = dataset_dir\n230:         self.identities = IdentityResolver(\n231:             os.path.join(dataset_dir, 'user_identities.csv'),\n232:             os.path.join(dataset_dir, 'user_audit_log.csv')\n233:         )\n234:         self.evidence_index = EvidenceIndex(dataset_dir)\n235:         self._load_system_activity()\n236: \n237:     def _load_system_activity(self):\n238:         self.system_activity: List[Dict[str, Any]] = []\n239:         act_path = os.path.join(self.dataset_dir, 'system_activity.csv')\n240:         if os.path.exists(act_path):\n241:             with open(act_path, mode='r', encoding='utf-8') as f:\n242:                 reader = csv.DictReader(f)\n243:                 for r in reader:\n244:                     self.system_activity.append(r)\n245: \n246:     def audit_case(self, case: Dict[str, Any]) -> Tuple[str, str]:\n247:         case_id = case['case_id']\n248:         email = str(case['email']).strip().lower()\n249:         audit_at = case['audit_at']\n250:         request_text = case.get('request_text', '')\n251: \n252:         # 1. Intent check\n253:         if not is_deletion_request(request_text):\n254:             return \"NOT_APPLICABLE\", \"[]\"\n255: \n256:         # 2. Resolve identity\n257:         user_profile = self.identities.resolve(email)\n258:         if not user_profile:\n259:             user_profile = {\n260:                 'user_id': None,\n261:                 'emails': {email},\n262:                 'phones': set(),\n263:                 'names': set(),\n264:                 'hashes': {hashlib.sha256(email.encode('utf-8')).hexdigest().lower()}\n265:             }\n266: \n267:         uid = user_profile['user_id']\n268:         emails = user_profile['emails']\n269: \n270:         # 3. Candidate files\n271:         candidate_files = self.evidence_index.get_candidate_files(audit_at)\n272:         \n273:         findings: List[Dict[str, Any]] = []\n274:         remediations: List[Dict[str, Any]] = []\n275:         verifications: List[Dict[str, Any]] = []\n276: \n277:         chosen_ev_id = \"\"\n278:         user_records_found = []\n279: \n280:         for f_meta in candidate_files:\n281:             eid = f_meta['file_id']\n282:             fpath = os.path.join(self.dataset_dir, f_meta['file_path'])\n283:             if not os.path.exists(fpath):\n284:                 continue\n285: \n286:             records = self._parse_evidence_file_for_user(eid, fpath, f_meta['origin'], user_profile)\n287:             if records:\n288:                 chosen_ev_id = eid\n289:                 user_records_found = records\n290:                 break\n291: \n292:         if not chosen_ev_id and candidate_files:\n293:             for f_meta in candidate_files:\n294:                 if 'failover_replica' in f_meta['file_path']:\n295:                     chosen_ev_id = f_meta['file_id']\n296:                     break\n297: \n298:         if not chosen_ev_id and candidate_files:\n299:             chosen_ev_id = candidate_files[0]['file_id']\n300: \n301:         # Determine account_id\n302:         account_id = None\n303:         for r in user_records_found:\n304:             if r.get('system_id') == 'account_service' and r.get('resource_id'):\n305:                 account_id = r.get('resource_id')\n306:                 break\n307: \n308:         if not account_id and uid:\n309:             m = re.match(r'^user_0*([1-9][0-9]?)$', uid)\n310:             if m and int(m.group(1)) <= 10:\n311:                 account_id = f\"account_{int(m.group(1)):03d}\"\n312: \n313:         if not account_id:\n314:             req_at = case.get('requested_at', '')\n315:             rep_at = case.get('reported_at', '')\n316:             for act in self.system_activity:\n317:                 if act.get('target_system') == 'account_service' and act.get('event_type') == 'DELETE_RECORD':\n318:                     t = act.get('event_time', '')\n319:                     if req_at <= t <= rep_at:\n320:                         account_id = act.get('resource_id')\n321:                         break\n322: \n323:         # Check account status\n324:         acc_status = \"ABSENT\"\n325:         for r in user_records_found:\n326:             if r.get('system_id') == 'account_service':\n327:                 if r.get('state') == 'PRESENT':\n328:                     acc_status = \"PRESENT\"\n329:                     account_id = r.get('resource_id', account_id)\n330:                     break\n331: \n332:         has_violations = False\n333:         if acc_status == \"PRESENT\":\n334:             has_violations = True\n335:             findings.append({\n336:                 \"phase\": \"FINDING\",\n337:                 \"system_id\": \"account_service\",\n338:                 \"resource_id\": account_id or \"account_001\",\n339:                 \"operation\": \"REPORT_REMAINING_RECORD\",\n340:                 \"state\": \"PRESENT\",\n341:                 \"evidence_id\": chosen_ev_id\n342:             })\n343:             remediations.append({\n344:                 \"phase\": \"REMEDIATION\",\n345:                 \"system_id\": \"account_service\",\n346:                 \"resource_id\": account_id or \"account_001\",\n347:                 \"operation\": \"DELETE_RECORD\",\n348:                 \"state\": \"ABSENT\",\n349:                 \"evidence_id\": \"\"\n350:             })\n351:             verifications.append({\n352:                 \"phase\": \"VERIFICATION\",\n353:                 \"system_id\": \"account_service\",\n354:                 \"resource_id\": account_id or \"account_001\",\n355:                 \"operation\": \"VERIFY_RECORD_ABSENT\",\n356:                 \"state\": \"ABSENT\",\n357:                 \"evidence_id\": \"\"\n358:             })\n359: \n360:         # Process secondary systems\n361:         for r in user_records_found:\n362:             sys_id = r.get('system_id')\n363:             res_id = r.get('resource_id')\n364:             op_type = r.get('type')\n365:             ev_cite = r.get('evidence_id', chosen_ev_id)\n366: \n367:             if sys_id == 'account_service':\n368:                 continue\n369: \n370:             if op_type == 'REMAINING_RECORD':\n371:                 has_violations = True\n372:                 findings.append({\n373:                     \"phase\": \"FINDING\",\n374:                     \"system_id\": sys_id,\n375:                     \"resource_id\": res_id,\n376:                     \"operation\": \"REPORT_REMAINING_RECORD\",\n377:                     \"state\": \"PRESENT\",\n378:                     \"evidence_id\": ev_cite\n379:                 })\n380:                 remediations.append({\n381:                     \"phase\": \"REMEDIATION\",\n382:                     \"system_id\": sys_id,\n383:                     \"resource_id\": res_id,\n384:                     \"operation\": \"DELETE_RECORD\",\n385:                     \"state\": \"ABSENT\",\n386:                     \"evidence_id\": \"\"\n387:                 })\n388:                 verifications.append({\n389:                     \"phase\": \"VERIFICATION\",\n390:                     \"system_id\": sys_id,\n391:                     \"resource_id\": res_id,\n392:                     \"operation\": \"VERIFY_RECORD_ABSENT\",\n393:                     \"state\": \"ABSENT\",\n394:                     \"evidence_id\": \"\"\n395:                 })\n396:             elif op_type == 'EXPOSED_PII':\n397:                 has_violations = True\n398:                 findings.append({\n399:                     \"phase\": \"FINDING\",\n400:                     \"system_id\": sys_id,"}
