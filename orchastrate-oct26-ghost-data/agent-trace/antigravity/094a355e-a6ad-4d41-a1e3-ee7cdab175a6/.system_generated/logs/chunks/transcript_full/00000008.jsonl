{"step_index":504,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T18:22:34Z","content":"Created At: 2026-10-24T23:52:34+05:30\nCompleted At: 2026-10-24T23:52:34+05:30\nShowing lines 1-200 of 925\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Ghost Data Still Exists — Autonomous Deletion Audit Agent\n4: HackerRank Orchestrate (October 2026)\n5: \n6: Fully deterministic, offline, zero-external-API deletion audit agent.\n7: Evaluates requests against multi-system evidence (databases, JSON snapshot bundles,\n8: structured service logs, text handovers, documents) up to audit_at timestamp.\n9: Enforces deletion_rules.csv policies, detects lingering PII and recreation hazards,\n10: and synthesizes ordered findings, remediation, and verification steps.\n11: \"\"\"\n12: \n13: import argparse\n14: import csv\n15: import hashlib\n16: import json\n17: import os\n18: import re\n19: import sqlite3\n20: import subprocess\n21: import sys\n22: from datetime import datetime\n23: from typing import Any, Dict, List, Optional, Set, Tuple\n24: \n25: # ==============================================================================\n26: # 1. INTENT CLASSIFIER\n27: # ==============================================================================\n28: \n29: NON_DELETION_PATTERNS = [\n30:     r'download my account information',\n31:     r'can\\'t access my profile',\n32:     r'cannot access my profile',\n33:     r'misspelled',\n34:     r'out of date',\n35:     r'stop the promotional emails',\n36:     r'remove me from marketing lists only',\n37:     r'what personal information you (hold|have)',\n38:     r'copy of last year\\'s invoices',\n39:     r'change the email address',\n40:     r'copy of the information held',\n41:     r'keep the account as it is',\n42:     r'leave the account active',\n43:     r'do not close the account',\n44:     r'don\\'t delete or change anything',\n45:     r'not asking for deletion',\n46:     r'not a request to erase',\n47:     r'update it to',\n48:     r'still need the account',\n49:     r'still use it',\n50:     r'in a portable format',\n51:     r'resetting the login',\n52:     r'leave my profile and purchase history in place',\n53:     r'correct it without removing',\n54: ]\n55: \n56: def is_deletion_request(text: str) -> bool:\n57:     \"\"\"Deterministically identifies non-deletion requests (GDPR Articles 15, 16, 20, opt-outs).\"\"\"\n58:     t = str(text).lower()\n59:     for pat in NON_DELETION_PATTERNS:\n60:         if re.search(pat, t):\n61:             return False\n62:     return True\n63: \n64: \n65: # ==============================================================================\n66: # 2. IDENTITY RESOLVER\n67: # ==============================================================================\n68: \n69: class IdentityResolver:\n70:     \"\"\"Resolves request emails to canonical user_id and builds full multi-temporal identity graph.\"\"\"\n71:     def __init__(self, identities_path: str, audit_log_path: str):\n72:         self.user_profiles: Dict[str, Dict[str, Any]] = {}\n73:         self.email_to_uid: Dict[str, str] = {}\n74:         self._load_identities(identities_path)\n75:         self._load_audit_log(audit_log_path)\n76:         # Compute SHA-256 for all known emails\n77:         for uid, p in self.user_profiles.items():\n78:             for em in p['emails']:\n79:                 h = hashlib.sha256(em.encode('utf-8')).hexdigest().lower()\n80:                 p['hashes'].add(h)\n81: \n82:     def _load_identities(self, path: str):\n83:         if not os.path.exists(path):\n84:             return\n85:         with open(path, mode='r', encoding='utf-8') as f:\n86:             reader = csv.DictReader(f)\n87:             for row in reader:\n88:                 uid = row['user_id']\n89:                 email = str(row['email']).strip().lower() if row.get('email') else None\n90:                 phone = str(row['phone']).strip() if row.get('phone') else None\n91:                 name = str(row['name']).strip().lower() if row.get('name') else None\n92:                 ehash = str(row['email_hash']).strip().lower() if row.get('email_hash') else None\n93:                 \n94:                 self.user_profiles[uid] = {\n95:                     'user_id': uid,\n96:                     'emails': {email} if email else set(),\n97:                     'phones': {phone} if phone else set(),\n98:                     'names': {name} if name else set(),\n99:                     'hashes': {ehash} if ehash else set(),\n100:                 }\n101:                 if email:\n102:                     self.email_to_uid[email] = uid\n103: \n104:     def _load_audit_log(self, path: str):\n105:         if not os.path.exists(path):\n106:             return\n107:         with open(path, mode='r', encoding='utf-8') as f:\n108:             reader = csv.DictReader(f)\n109:             for row in reader:\n110:                 uid = row['user_id']\n111:                 if uid not in self.user_profiles:\n112:                     self.user_profiles[uid] = {\n113:                         'user_id': uid,\n114:                         'emails': set(),\n115:                         'phones': set(),\n116:                         'names': set(),\n117:                         'hashes': set(),\n118:                     }\n119:                 field = row.get('field_name')\n120:                 for val in [row.get('old_value'), row.get('new_value')]:\n121:                     if val and val.strip():\n122:                         v = val.strip()\n123:                         if field == 'email':\n124:                             self.user_profiles[uid]['emails'].add(v.lower())\n125:                             self.email_to_uid[v.lower()] = uid\n126:                         elif field == 'email_hash':\n127:                             self.user_profiles[uid]['hashes'].add(v.lower())\n128:                         elif field == 'phone':\n129:                             self.user_profiles[uid]['phones'].add(v)\n130:                         elif field == 'name':\n131:                             self.user_profiles[uid]['names'].add(v.lower())\n132: \n133:     def resolve(self, email: str) -> Optional[Dict[str, Any]]:\n134:         clean_email = str(email).strip().lower()\n135:         uid = self.email_to_uid.get(clean_email)\n136:         if uid and uid in self.user_profiles:\n137:             return self.user_profiles[uid]\n138:         return None\n139: \n140: \n141: # ==============================================================================\n142: # 3. EVIDENCE PARSER & EXTRACTOR\n143: # ==============================================================================\n144: \n145: class EvidenceIndex:\n146:     \"\"\"Indexes evidence files manifest with parsed timestamps.\"\"\"\n147:     def __init__(self, dataset_dir: str):\n148:         self.dataset_dir = dataset_dir\n149:         self.manifest_path = os.path.join(dataset_dir, 'evidence_files.csv')\n150:         self.manifest_rows: List[Dict[str, Any]] = []\n151:         self._load_manifest()\n152: \n153:     def _load_manifest(self):\n154:         if not os.path.exists(self.manifest_path):\n155:             return\n156:         with open(self.manifest_path, mode='r', encoding='utf-8') as f:\n157:             reader = csv.DictReader(f)\n158:             for r in reader:\n159:                 self.manifest_rows.append({\n160:                     'file_id': r['file_id'],\n161:                     'file_path': r['file_path'],\n162:                     'origin': r['origin'],\n163:                     'captured_at': r['captured_at'],\n164:                 })\n165: \n166:     def get_candidate_files(self, audit_at: str) -> List[Dict[str, Any]]:\n167:         valid = [r for r in self.manifest_rows if r['captured_at'] <= audit_at]\n168:         valid.sort(key=lambda x: x['captured_at'], reverse=True)\n169:         return valid\n170: \n171: \n172: # ==============================================================================\n173: # 4. POLICY ENGINE & STEP SYNTHESIZER\n174: # ==============================================================================\n175: \n176: FINDING_ORDER = [\n177:     'REPORT_REMAINING_RECORD',\n178:     'REPORT_EXPOSED_PII',\n179:     'REPORT_ACTIVE_DATA_FLOW',\n180:     'REPORT_RESTORE_RISK'\n181: ]\n182: \n183: REMEDIATION_ORDER = [\n184:     'DISABLE_DATA_FLOW',\n185:     'BLOCK_RESTORE',\n186:     'DELETE_RECORD',\n187:     'REDACT_RECORD',\n188:     'ANONYMIZE_RECORD'\n189: ]\n190: \n191: VERIFICATION_ORDER = [\n192:     'VERIFY_RECORD_ABSENT',\n193:     'VERIFY_RECORD_PRESENT',\n194:     'VERIFY_RECORD_REDACTED',\n195:     'VERIFY_RECORD_ANONYMIZED',\n196:     'VERIFY_DATA_FLOW_DISABLED',\n197:     'VERIFY_RESTORE_BLOCKED'\n198: ]\n199: \n200: def sort_steps(steps: List[Dict[str, Any]]) -> List[Dict[str, Any]]:"}
