{"step_index":424,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T18:12:46Z","content":"Created At: 2026-10-24T23:42:46+05:30\nCompleted At: 2026-10-24T23:42:46+05:30\nShowing lines 1-60 of 145\n1: \"\"\"\n2: Evaluation and Correctness Test Runner for Ghost Data Still Exists.\n3: Compares candidate predictions against ground truth (sample_output.csv and custom_test_suite.py)\n4: and computes case-level, step-level, field-level, and sequence accuracy metrics.\n5: \"\"\"\n6: \n7: import json\n8: import os\n9: import sys\n10: from typing import List, Dict, Any, Tuple\n11: import pandas as pd\n12: \n13: try:\n14:     from custom_test_suite import CUSTOM_TEST_CASES\n15: except ImportError:\n16:     from code.evaluation.custom_test_suite import CUSTOM_TEST_CASES\n17: \n18: \n19: def evaluate_predictions(pred_df: pd.DataFrame, gt_df: pd.DataFrame) -> Dict[str, Any]:\n20:     \"\"\"\n21:     Evaluates pred_df against gt_df across:\n22:       - status_accuracy\n23:       - step_precision, step_recall, step_f1\n24:       - field_accuracy\n25:       - sequence_accuracy\n26:     \"\"\"\n27:     gt_map = {row['case_id']: row for _, row in gt_df.iterrows()}\n28:     \n29:     total_cases = 0\n30:     correct_status = 0\n31:     \n32:     total_expected_steps = 0\n33:     total_predicted_steps = 0\n34:     total_matched_steps = 0\n35:     \n36:     total_fields = 0\n37:     correct_fields = 0\n38:     \n39:     total_seq_eval = 0\n40:     correct_seq = 0\n41:     \n42:     step_fields = ['phase', 'system_id', 'resource_id', 'operation', 'state', 'evidence_id']\n43:     \n44:     for _, pred_row in pred_df.iterrows():\n45:         cid = pred_row['case_id']\n46:         if cid not in gt_map:\n47:             continue\n48:             \n49:         gt_row = gt_map[cid]\n50:         total_cases += 1\n51:         \n52:         # 1. Status Accuracy\n53:         p_status = str(pred_row['deletion_status']).strip()\n54:         g_status = str(gt_row['deletion_status']).strip()\n55:         if p_status == g_status:\n56:             correct_status += 1\n57:             \n58:         # Parse steps\n59:         try:\n60:             p_steps = json.loads(pred_row['steps_json']) if isinstance(pred_row['steps_json'], str) else pred_row['steps_json']"}
