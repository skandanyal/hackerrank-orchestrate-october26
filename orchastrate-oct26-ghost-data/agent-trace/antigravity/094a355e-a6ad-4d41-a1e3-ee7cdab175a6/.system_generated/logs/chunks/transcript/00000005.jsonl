{"step_index":426,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-24T18:12:51Z","content":"Created At: 2026-10-24T23:42:51+05:30\nCompleted At: 2026-10-24T23:42:51+05:30\nShowing lines 61-145 of 145\n61:         except Exception:\n62:             p_steps = []\n63:             \n64:         try:\n65:             g_steps = json.loads(gt_row['steps_json']) if isinstance(gt_row['steps_json'], str) else gt_row['steps_json']\n66:         except Exception:\n67:             g_steps = []\n68:             \n69:         total_predicted_steps += len(p_steps)\n70:         total_expected_steps += len(g_steps)\n71:         \n72:         # Step matching: match on (phase, system_id, resource_id, operation)\n73:         def step_key(s):\n74:             return (s.get('phase'), s.get('system_id'), s.get('resource_id'), s.get('operation'))\n75:             \n76:         g_keyed = {step_key(s): s for s in g_steps}\n77:         p_keyed = {step_key(s): s for s in p_steps}\n78:         \n79:         matched_keys = set(g_keyed.keys()).intersection(set(p_keyed.keys()))\n80:         total_matched_steps += len(matched_keys)\n81:         \n82:         # Field accuracy on matched steps\n83:         for k in matched_keys:\n84:             gs = g_keyed[k]\n85:             ps = p_keyed[k]\n86:             for f in step_fields:\n87:                 total_fields += 1\n88:                 if gs.get(f) == ps.get(f):\n89:                     correct_fields += 1\n90:                     \n91:         # Sequence accuracy: check if sequence of step_keys matches exactly\n92:         if len(g_steps) > 0 or len(p_steps) > 0:\n93:             total_seq_eval += 1\n94:             g_seq = [step_key(s) for s in g_steps]\n95:             p_seq = [step_key(s) for s in p_steps]\n96:             if g_seq == p_seq:\n97:                 correct_seq += 1\n98: \n99:     precision = total_matched_steps / total_predicted_steps if total_predicted_steps > 0 else 1.0\n100:     recall = total_matched_steps / total_expected_steps if total_expected_steps > 0 else 1.0\n101:     f1 = (2 * precision * recall) / (precision + recall) if (precision + recall) > 0 else 0.0\n102:     status_acc = correct_status / total_cases if total_cases > 0 else 0.0\n103:     field_acc = correct_fields / total_fields if total_fields > 0 else 1.0\n104:     seq_acc = correct_seq / total_seq_eval if total_seq_eval > 0 else 1.0\n105:     \n106:     return {\n107:         \"total_cases\": total_cases,\n108:         \"status_accuracy\": status_acc,\n109:         \"precision\": precision,\n110:         \"recall\": recall,\n111:         \"f1\": f1,\n112:         \"field_accuracy\": field_acc,\n113:         \"sequence_accuracy\": seq_acc,\n114:         \"matched_steps\": total_matched_steps,\n115:         \"expected_steps\": total_expected_steps,\n116:         \"predicted_steps\": total_predicted_steps\n117:     }\n118: \n119: \n120: def main():\n121:     print(\"=== Ghost Data Still Exists: Evaluation Suite ===\")\n122:     sample_gt_path = \"dataset/sample_output.csv\"\n123:     if not os.path.exists(sample_gt_path):\n124:         sample_gt_path = \"../../dataset/sample_output.csv\"\n125:         \n126:     if os.path.exists(sample_gt_path):\n127:         gt_df = pd.read_csv(sample_gt_path)\n128:         print(f\"Loaded {len(gt_df)} sample ground truth cases from {sample_gt_path}.\")\n129:         \n130:         # Self-test baseline\n131:         metrics = evaluate_predictions(gt_df, gt_df)\n132:         print(\"\\nBaseline Self-Test Results (Ideal 100%):\")\n133:         for k, v in metrics.items():\n134:             if isinstance(v, float):\n135:                 print(f\"  {k:20s}: {v*100:6.2f}%\")\n136:             else:\n137:                 print(f\"  {k:20s}: {v}\")\n138:     else:\n139:         print(\"Sample ground truth file not found.\")\n140:         \n141:     print(f\"\\nLoaded {len(CUSTOM_TEST_CASES)} custom test cases.\")\n142: \n143: \n144: if __name__ == \"__main__\":\n145:     main()"}
