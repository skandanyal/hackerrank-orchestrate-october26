n    audit_dt = pd.to_datetime(r['audit_at'])\\n    expected_eids = {s['evidence_id'] for s in json.loads(r['steps_json']) if s.get('evidence_id')}\\n    \\n    # Candidate evidence files with cap_dt <= audit_dt\\n    candidates = manifest[manifest['cap_dt'] <= audit_dt].sort_values('cap_dt', ascending=False)\\n    \\n    # Find matching candidate files that contain user info\\n    matched = []\\n    for eid, row in candidates.iterrows():\\n        fpath = os.path.join('dataset', row['file_path'])\\n        if os.path.exists(fpath):\\n            try:\\n                with open(fpath, errors='ignore') as fp:\\n                    content = fp.read()\\n                    if email in content.lower() or (uid and uid in content):\\n                        matched.append(eid)\\n            except Exception:\\n                pass\\n    top_matched = set(matched[:len(expected_eids)]) if matched else set()\\n    if top_matched == expected_eids:\\n        correct_ev += 1\\n   \n<truncated 207 bytes>","WaitMsBeforeAsync":"5000","toolSummary":"\"Test evidence candidate selection by timestamp\""}}],"truncated_fields":["tool_calls"]}
