email_to_uid[em] = uid\\n\\nfor _, a in audit.iterrows():\\n    uid = a['user_id']\\n    if uid not in user_graphs:\\n        user_graphs[uid] = {'user_id': uid, 'emails': set(), 'phones': set(), 'hashes': set(), 'names': set()}\\n    fn = a['field_name']\\n    for val in [a['old_value'], a['new_value']]:\\n        if pd.notna(val):\\n            val_s = str(val).strip()\\n            if fn == 'email':\\n                user_graphs[uid]['emails'].add(val_s.lower())\\n                email_to_uid[val_s.lower()] = uid\\n            elif fn == 'phone':\\n                user_graphs[uid]['phones'].add(val_s)\\n            elif fn == 'name':\\n                user_graphs[uid]['names'].add(val_s.lower())\\n\\nprint(f'Indexed {len(user_graphs)} users and {len(email_to_uid)} emails.')\\n\\n# Test on case_01 to case_05\\nfor idx, r in sample_req.merge(sample_out, on='case_id').head(5).iterrows():\\n    cid = r['case_id']\\n    req_email = str(r['email']).strip().lower()\\n    uid = email_to_uid.get(req_email)\\n    g = user_graphs.get(uid)\\n    steps = json.loads(r['steps_json'])\\n    expected_res = [s['reso\n<truncated 129 bytes>","WaitMsBeforeAsync":"5000","toolSummary":"\"Verify user identity resolution for sample cases\""}}],"truncated_fields":["tool_calls"]}
