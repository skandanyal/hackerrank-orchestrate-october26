idx, r in eval_req.iterrows():\\n    if not is_deletion_request(r['request_text']):\\n        print(f'  {r[\\\\\\\"case_id\\\\\\\"]}: {r[\\\\\\\"request_text\\\\\\\"]}')\\n\\\"\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Test intent classification on sample and eval requests\""}}]}
