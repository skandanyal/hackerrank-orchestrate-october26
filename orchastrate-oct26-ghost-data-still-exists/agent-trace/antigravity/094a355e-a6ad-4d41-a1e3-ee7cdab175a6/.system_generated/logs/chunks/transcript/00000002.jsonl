c[eid, 'captured_at']\\n        ev_info.append(f'{eid} (cap: {cap})')\\n    print(f\\\\\\\"{cid}: req={r['requested_at']}, rep={r['reported_at']}, audit={r['audit_at']} | Ev: {', '.join(ev_info)}\\\\\\\")\\n\\\"\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Inspect cited evidence capture timestamps vs audit_at\""}}]}
